NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=shopfloor
DB_PASSWORD=
DB_NAME=denso_shopfloor
# Aiven: enable TLS and paste its CA certificate (PEM, literal \\n also accepted).
DB_SSL=false
DB_SSL_CA=
# Render Free: mysql stores attachment bytes durably in the database.
FILE_STORAGE=filesystem
SERVE_FRONTEND=false
# Render terminates HTTPS at one trusted reverse proxy.
TRUST_PROXY=0
# Required only when using compose.yaml; use a different password from DB_PASSWORD.
MYSQL_ROOT_PASSWORD=
SESSION_HOURS=8
UPLOAD_MAX_MB=20
# Used only by db:seed. Set your own password before seeding.
SEED_PASSWORD=
