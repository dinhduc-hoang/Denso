{
  "name": "denso-meeting-shopfloor-be",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:cloud": "node scripts/start-cloud.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:seed:minimal": "node scripts/seed.js --minimal",
    "db:local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-mysql.ps1",
    "db:local:stop": "node scripts/local-mysql.js stop",
    "db:local:status": "node scripts/local-mysql.js status",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "test:cloud": "node --test --test-concurrency=1 tests/cloud/*.test.js tests/integration/workflow.test.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "zod": "^4.1.12"
  }
}
