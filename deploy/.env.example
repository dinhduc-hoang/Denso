# Copy this example to deploy/.env.docker and fill in the MySQL connection.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=defaultdb
DB_SSL=true
# One-line PEM with literal \n between lines when using docker --env-file.
DB_SSL_CA=
# Demo login shown in the frontend; seed preserves existing user passwords.
SEED_PASSWORD=DensoDemo@2026!
